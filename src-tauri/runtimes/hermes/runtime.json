{
    "id":  "hermes",
    "name":  "Hermes Agent",
    "description":  "Hermes AI Agent 瀵硅瘽涓庡伐鍏疯繍琛屾椂",
    "version":  "0.18.2",
    "category":  "agent",
    "icon":  "hermes",
    "launch":  {
                   "command":  "{runtimeDir}/python/python.exe",
                   "args":  [
                                "-m",
                                "hermes_cli.main",
                                "dashboard",
                                "--port",
                                "{guiPort}",
                                "--host",
                                "127.0.0.1",
                                "--no-open",
                                "--skip-build"
                            ],
                   "cwd":  ".",
                   "healthUrl":  "http://127.0.0.1:{guiPort}/api/status",
                   "readyTimeoutMs":  60000,
                   "env":  {
                               "PYTHONUTF8":  "1",
                               "PYTHONIOENCODING":  "utf-8",
                               "HERMES_DASHBOARD_SESSION_TOKEN":  "kfc-desk-3463b6e3f34d0f12fc416939e9a81fc395f40f4730cfc145"
                           }
               },
    "requires":  {
                     "python":  {
                                    "bundled":  "python.zip",
                                    "min_version":  "3.11",
                                    "check":  "python --version"
                                }
                 },
    "gui":  {
                "type":  "web",
                "urlTemplate":  "http://127.0.0.1:{guiPort}/",
                "defaultGuiPort":  5174
            },
    "ports":  {
                  "gui":  {
                              "default":  5174,
                              "env":  "HERMES_GUI_PORT"
                          },
                  "gateway":  {
                                  "default":  5174,
                                  "env":  "HERMES_GATEWAY_PORT"
                              }
              },
    "capabilities":  [
                         "chat",
                         "tools",
                         "skills",
                         "memory",
                         "cron",
                         "browser",
                         "platforms"
                     ]
}
